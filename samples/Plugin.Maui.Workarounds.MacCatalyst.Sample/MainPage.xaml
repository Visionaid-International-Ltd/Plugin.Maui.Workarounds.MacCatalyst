<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Plugin.Maui.Workarounds.MacCatalyst.Sample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mac Catalyst Workarounds">

    <VerticalStackLayout MaximumWidthRequest="1920" MaximumHeightRequest="1080" BackgroundColor="DarkGreen">
        <Button Text="Focusable button" />
        <Button Text="Another button" />
        <Entry Placeholder="Entry control" />
        <Entry Placeholder="Another entry control" />
        <Slider />
        <Picker>
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Item 1</x:String>
                    <x:String>Item 2</x:String>
                    <x:String>Item 3</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
    </VerticalStackLayout>

</ContentPage>
